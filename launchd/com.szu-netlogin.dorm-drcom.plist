<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.szu-netlogin.dorm-drcom</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>-m</string>
    <string>src.szu_netlogin.login</string>
    <string>--check-and-login</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SZU_NETLOGIN_HOME</key>
    <string>__PROJECT_ROOT__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>120</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchagent.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchagent.err.log</string>
</dict>
</plist>
